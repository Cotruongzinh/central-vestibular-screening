{
  "expo": {
    "name": "Central Vestibular Screening",
    "slug": "central-vestibular-screening",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "centralvestibularscreening",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.centralvestibular.screening",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng sử dụng camera để theo dõi chuyển động mắt trong quá trình kiểm tra.",
        "NSFaceIDUsageDescription": "Ứng dụng sử dụng Face ID để xác thực phiên làm việc của chuyên viên."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.centralvestibular.screening",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép $(PRODUCT_NAME) sử dụng Face ID để xác thực phiên làm việc của chuyên viên."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép $(PRODUCT_NAME) truy cập thư viện ảnh để chọn logo cơ sở.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Ứng dụng hỗ trợ sàng lọc tiền đình trung ương bằng theo dõi chuyển động mắt."
  }
}
